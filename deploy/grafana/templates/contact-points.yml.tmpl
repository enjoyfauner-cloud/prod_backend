# Уведомления алертов в Telegram. Шаблон: __TELEGRAM_*__ подставляет deploy/grafana/entrypoint.sh
# из переменных окружения (TELEGRAM_BOT_TOKEN, TELEGRAM_CHAT_ID в .env.prod), в репозитории их нет.
# Почему не $VAR: Grafana 11 превращает подставленный числовой chat_id в число и не стартует.
apiVersion: 1
contactPoints:
  - orgId: 1
    name: telegram
    receivers:
      - uid: sovetnik-telegram
        type: telegram
        disableResolveMessage: false
        settings:
          bottoken: "__TELEGRAM_BOT_TOKEN__"
          chatid: "__TELEGRAM_CHAT_ID__"
          parse_mode: HTML
          message: |
            {{ if eq .Status "firing" }}🔴{{ else }}✅{{ end }} <b>{{ .CommonLabels.alertname }}</b> — {{ .Status }}
            {{ range .Alerts }}{{ .Annotations.summary }}
            {{ .Annotations.description }}
            {{ end }}

policies:
  - orgId: 1
    receiver: telegram
    group_by: ["alertname"]
    group_wait: 10s
    group_interval: 1m
    repeat_interval: 1h
