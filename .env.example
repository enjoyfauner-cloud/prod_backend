# Скопируйте в .env и при необходимости поменяйте значения.
# Окружение: local | test | production
APP_ENV=local
# Строка подключения к PostgreSQL (драйвер asyncpg)
DATABASE_URL=postgresql+asyncpg://sovetnik:sovetnik@localhost:5433/sovetnik
# Домены фронтенда через запятую
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
# Уровень логов: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
# Часовой пояс для «сегодня» в расчётах и текущего месяца лимитов
APP_TIMEZONE=Europe/Moscow
# Размер пула соединений к БД
DB_POOL_SIZE=5
# Импортировать демо-каталог при старте (сервис migrate в docker-compose)
SEED_DEMO=true
# Для интеграционных тестов
TEST_DATABASE_URL=postgresql+asyncpg://sovetnik:sovetnik@localhost:5433/sovetnik_test
# Пароли для docker-compose
POSTGRES_PASSWORD=sovetnik
# Порт Postgres на хосте (5432 часто занят локальным Postgres)
POSTGRES_HOST_PORT=5433
GRAFANA_ADMIN_PASSWORD=admin
